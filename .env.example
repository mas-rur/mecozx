# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - server-side ONLY, never expose to the browser.
# Used exclusively by the /secure/admin dashboard to read submissions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin dashboard (domain.com/secure/admin) ---
# Pick a strong password - this gates the admin dashboard.
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random string used to sign the admin session cookie. Generate with:
# openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-a-random-64-char-hex-string
